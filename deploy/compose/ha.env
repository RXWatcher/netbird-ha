# Environment for this repository's management and signal (NBHA_IMPL=ha).
# Variable names: README.md (ha/) and dispatcher/README.md. Per-instance IDs
# and the shared WireGuard key are set in compose.yml.
#
# All three Redis variables take the same URL; here the Sentinel form
# (go-redis ParseFailoverURL), so each instance follows the Valkey master itself.

# Management: update bus (turns HA on).
NB_HA_REDIS_URL=redis://sentinel-1:26379/0?master_name=nbha&addr=sentinel-2:26379&addr=sentinel-3:26379
# Short resync so that scenario 4 (Sentinel failover) converges within a minute.
NB_HA_RESYNC_INTERVAL=30s
# Management cache (sessions, PKCE, tokens, IdP cache).
NB_CACHE_REDIS_ADDRESS=redis://sentinel-1:26379/0?master_name=nbha&addr=sentinel-2:26379&addr=sentinel-3:26379
# Signal dispatcher.
NB_SIGNAL_REDIS_URL=redis://sentinel-1:26379/0?master_name=nbha&addr=sentinel-2:26379&addr=sentinel-3:26379
